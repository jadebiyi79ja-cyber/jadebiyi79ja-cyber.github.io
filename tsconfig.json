{
  "compilerOptions": {
    // Modern browsers only; Vite does the actual bundling
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"],
    // "@/components/ui/x" means "src/components/ui/x" (shadcn convention; mirrored in vite.config.ts)
    "paths": { "@/*": ["./src/*"] },

    // Type-check only: Vite produces the real output
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,

    // Catch mistakes early
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
